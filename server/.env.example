# Copy to .env and adjust. The Makefile and Docker Compose load .env; the
# binary reads the process environment. Relative paths resolve against the
# working directory.

# development (readable text logs) or production (JSON logs)
APP_ENV=development

# Port the API listens on
API_PORT=8080

# Where the server keeps its local data (database files under pg/); created
# if missing. Keep the ./ prefix: Compose needs it for a relative folder.
DATA_DIR=./data

# Folder of the built web app to serve on the same origin (for example the
# client's dist folder). Leave empty to serve only the API.
WEB_DIST_DIR=

# Local Postgres (compose.yaml). Change the port if 5432 is taken, and keep
# DATABASE_URL in step with it.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mirror
DATABASE_URL=postgres://mirror:mirror@localhost:5432/mirror?sslmode=disable

# Email by SMTP (sign-in codes). Leave SMTP_HOST empty to write codes to the
# log instead; production requires SMTP. Port 587 uses STARTTLS, 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Mirror <you@example.com>

# AI (CV parsing) through Groq. The model must support strict JSON schema.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Encrypts uploaded files: 32 bytes in base64. Make one with:
#   openssl rand -base64 32
# Losing it makes every stored file unreadable; keep a copy somewhere safe.
FILE_ENCRYPTION_KEY=

# Local embedding server (the "embed" service in compose.yaml). Change the
# port if 8090 is taken, and keep EMBED_URL in step with it.
EMBED_PORT=8090
EMBED_URL=http://localhost:8090

# Signs download links (CV downloads expire after 15 minutes): 32 bytes in
# base64. Make one with: openssl rand -base64 32
FILE_SIGNING_KEY=
