# Copy to .env and adjust. The Makefile loads .env; the binary reads the
# process environment. Relative paths resolve against the working directory.

# development (readable text logs) or production (JSON logs)
APP_ENV=development

# Port the API listens on
API_PORT=8080

# Where the server keeps its local data; created if missing
DATA_DIR=data

# Folder of the built web app to serve on the same origin (for example the
# client's dist folder). Leave empty to serve only the API.
WEB_DIST_DIR=
