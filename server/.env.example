# Copy to .env and adjust. The Makefile and Docker Compose load .env; the
# binary reads the process environment. Relative paths resolve against the
# working directory.

# development (readable text logs) or production (JSON logs)
APP_ENV=development

# Port the API listens on
API_PORT=8080

# Where the server keeps its local data (database files under pg/); created
# if missing. Keep the ./ prefix: Compose needs it for a relative folder.
DATA_DIR=./data

# Folder of the built web app to serve on the same origin (for example the
# client's dist folder). Leave empty to serve only the API.
WEB_DIST_DIR=

# Local Postgres (compose.yaml). Change the port if 5432 is taken, and keep
# DATABASE_URL in step with it.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mirror
DATABASE_URL=postgres://mirror:mirror@localhost:5432/mirror?sslmode=disable
