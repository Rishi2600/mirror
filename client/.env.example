# Copy to .env and adjust. Vite and bun run both read .env from this folder.

# API address baked into production builds. Empty means the same origin
# the app is served from.
VITE_API_URL=

# Where the dev server proxies /v1 (including WebSockets).
API_PROXY_TARGET=http://localhost:8080

# The server's API contract for `bun run gen`: a URL or a file path.
API_SPEC=http://localhost:8080/v1/openapi.yaml
